# 本地开发 / 构建配置
# 复制为 .env 后按需填写。.env 已被 .gitignore 忽略，禁止提交。
# 已导出的同名环境变量优先于本文件，因此 CI Secret 与临时覆盖不受影响。

# ── WB 渠道（npm run dev:wb / build:wb）必需 ──
# 以下两个 URL 必须是纯 HTTP(S) origin：协议 + 域名 + 可选端口，不能带路径、查询、片段或账号密码。
GOLD_BAND_WB_BASE_URL=
GOLD_BAND_WB_MULTICA_URL=
# WB 书签与内置角色的公共 DNS 后缀。只填域名（例如 corp.example），不含协议、端口或路径。
GOLD_BAND_WB_INTERNAL_DOMAIN=

# ── WB 渠道（npm run build:wb）必需 ──
# wb 渠道开启 metrics，打包前必须提供 metrics key；dev:wb 不需要。
GOLD_BAND_METRICS_API_KEY=

# ── WB 渠道打包签名（npm run build:wb）必需 ──
# 两种写法二选一，优先使用 PATH 形式，避免把私钥内容写进本文件：
#   1. TAURI_SIGNING_PRIVATE_KEY_PATH=<私钥文件绝对路径>
#   2. TAURI_SIGNING_PRIVATE_KEY=<私钥文件内容>
# 注意：TAURI_SIGNING_PRIVATE_KEY 要求的是密钥内容本身，直接填文件路径会因 base64 解码失败而报错。
TAURI_SIGNING_PRIVATE_KEY_PATH=
# 私钥设置了密码时才需要；空密码私钥请保持注释或留空。
# TAURI_SIGNING_PRIVATE_KEY_PASSWORD=
